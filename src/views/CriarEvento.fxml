<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.CriarEventoController">
    <Label text="Criar Novo Evento"/>
    <TextField fx:id="txtNome" promptText="Nome do Evento"/>
    <TextField fx:id="txtData" promptText="Data (dd/mm/aaaa)"/>
    <Button text="Salvar" onAction="#salvarEvento"/>
</VBox>
